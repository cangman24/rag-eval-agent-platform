# Python 编译缓存
__pycache__/
*.py[cod]
*.egg-info/

# 虚拟环境
.venv/
venv/
miniconda3/
conda-env/

# 环境、密钥（严禁提交）
.env
.env.local
*.key

# 模型、向量索引、大体积中间数据（不入库）
models/
data/vectors/
data/raw/
data/cache/
data/checkpoints/
data/demo_docs/
data/demo_chunks.json
data/demo_evalrun_docs/
*.faiss
*.index

# 保留基准评测集（可复现评测的数据集，纳入版本）
!data/eval/
!data/eval/*.jsonl

# 评测输出产物：demo演示报告忽略；正式 run-* 的报告保留
reports/demo-*/
reports/demo_*.md
reports/ingest_manifest.json
reports/*.tmp

# 日志、临时文件
*.log
demo_*.txt
*.tmp

# 测试临时目录
tests/.tmp/

# IDE 配置
.idea/
.vscode/

# Mac系统文件
.DS_Store
