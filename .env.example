# ---------------------------------------------------------------------------
# 环境变量模板 —— 复制成 .env 后填写真实值
#
#   cp .env.example .env
#
# ★ .env 已在 .gitignore 中，**绝不要**把填好的 .env 提交上去。
# ---------------------------------------------------------------------------

# ------------------------------------------------------------------ 必填
# DeepSeek API Key。不填也能跑，但服务会降级为"只回检索片段"模式
# （bootstrap 会打印 [warn] 提示，耗时只有几百毫秒且不产生网络请求）。
DEEPSEEK_API_KEY=

# ------------------------------------------------------------------ 选填
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 本地模型路径（从 HuggingFace 下载后放在这里）
BGE_M3_PATH=models/bge-m3
BGE_RERANKER_PATH=models/bge-reranker-v2-m3

# 语料与索引
RAG_DOCS_DIR=data/raw
RAG_CHUNKS_FILE=data/vectors/chunks.json
RAG_VECTORS_FILE=data/vectors/vectors.json

# 切分参数（★ 这两个值应当由网格搜索实测决定，不要凭感觉写。
#   写进简历的数字必须来自实测，见 reports/run-*/eval_manifest.json）
RAG_CHUNK_SIZE=512
RAG_OVERLAP=64
RAG_PARENT_SIZE=2048

# 检索参数
RAG_TOP_K=5
RAG_RECALL_K=20

# ★ 拒答阈值：判据是「精排后最高分 < 阈值」就拒答。
#   注意 rerank 分数是**未归一化的 logit**（实测正例约 1~5，反例为负），
#   不是 [0,1] 概率。换 reranker 或换归一化方式时必须重新标定这个值，
#   否则会出现"该答的拒答"或"该拒的硬答"。
RAG_REFUSAL_THRESHOLD=0.3
